# ─── Django core ───────────────────────────────────────────────────────────────
# Generate a secret key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# NEVER leave this on in production. Set to False when deploying.
DEBUG=True

# Comma-separated list of host/domain names this site may serve.
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Comma-separated list of trusted origins for CSRF (include scheme + port).
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── Database ──────────────────────────────────────────────────────────────────
DB_NAME=CoDO
DB_USER=postgres
DB_PASSWORD=your password
DB_HOST=localhost
DB_PORT=5432

# Optional tuning
DB_CONN_MAX_AGE=600
DB_CONNECT_TIMEOUT=10

# ─── CORS ──────────────────────────────────────────────────────────────────────
# Frontend origins allowed to call the API (comma-separated).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Only set this to True for quick local testing — it cannot be combined with
# credentials and browsers will reject authenticated requests.
CORS_ALLOW_ALL_ORIGINS=False

# ─── Redis (optional but recommended for production) ───────────────────────────
# Enables a shared cache AND a multi-process Channels layer.
# Without it, the in-memory layer/cache only works for a single process.
REDIS_URL=redis://127.0.0.1:6379/0

# ─── Cloudinary (image uploads) ────────────────────────────────────────────────
CLOUD_NAME=your_cloud_name
CLOUD_API_KEY=your_cloud_api_key
CLOUD_SECRET_KEY=your_secret_key

# ─── GitHub OAuth ──────────────────────────────────────────────────────────────
GIT_HUB_ID=your_github_client_id
GIT_HUB_SECRET_KEY=your_github_client_secret

# ─── Email (password reset / notifications) ────────────────────────────────────
EMAIL_HOST_USER=**********************
EMAIL_HOST_PASSWORD=*********************
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@codo.local

# ─── API tuning ────────────────────────────────────────────────────────────────
API_PAGE_SIZE=20
DRF_ANON_THROTTLE=60/min
DRF_USER_THROTTLE=600/min

# ─── JWT ───────────────────────────────────────────────────────────────────────
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# ─── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
DJANGO_LOG_LEVEL=INFO
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5

# Admins to email on 500 errors: "Name:email@example.com,Other:other@example.com"
ADMINS=

# ─── Security (applied automatically when DEBUG=False) ─────────────────────────
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
