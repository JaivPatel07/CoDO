# CoDO frontend — environment variables
#
# Copy this file to `.env.local` and adjust for your machine:
#     cp .env.example .env.local
#
# Vite only exposes variables prefixed with `VITE_` to the browser bundle, and
# it inlines them at BUILD time — restart the dev server (or rebuild) after
# changing any of them.

# ── Backend ────────────────────────────────────────────────────────────────
# Base URL of the Django REST API. Include the scheme and port, no trailing
# slash. In development, Vite's proxy (see vite.config.js) forwards /api, /ws,
# /admin, /media and /static to this origin.
#
# Leave it unset to use the default of http://127.0.0.1:8000.
VITE_API_URL=http://127.0.0.1:8000

# ── WebSockets ─────────────────────────────────────────────────────────────
# WebSocket endpoint for realtime features (chat, notifications, workspaces).
# Leave it unset and it is derived from VITE_API_URL by rewriting the scheme
# (http -> ws, https -> wss). Set it explicitly only when your WebSocket server
# lives on a different host or port than the HTTP API — for example when TLS is
# terminated by a proxy that speaks HTTP/2 but not the WebSocket upgrade.
#
# VITE_WS_URL=wss://api.example.com/ws

# ── Timeouts ───────────────────────────────────────────────────────────────
# Request timeout in milliseconds. Prevents infinite skeleton loaders when the
# backend hangs. Defaults to 15000.
#
# VITE_API_TIMEOUT_MS=15000
